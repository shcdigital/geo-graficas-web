---
// src/layouts/Layout.astro
// Layout base: esqueleto SEO/accesibilidad no removible.
import "../styles/global.css";
import { SITE } from "../data/site";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
}

const {
  title = `${SITE.nombre} — ${SITE.tagline}`,
  description = SITE.bio,
  ogImage = `${import.meta.env.SITE}/logo.png`,
  ogType = "website",
} = Astro.props;

const fullTitle = title.includes(SITE.nombre) ? title : `${title} · ${SITE.nombre}`;
const restoRuta = Astro.url.pathname.slice(import.meta.env.BASE_URL.length - 1);
const canonical = `${import.meta.env.SITE}${restoRuta}`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ee2a7b" />
    <meta name="robots" content="index, follow" />
    <link rel="icon" type="image/png" href={`${import.meta.env.BASE_URL}favicon.png`} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content={SITE.nombre} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    
    <!-- Alpine.js store definition (runs before Alpine loads) -->
    <script is:inline>
      document.addEventListener('alpine:init', () => {
        Alpine.store('cart', {
          items: [],
          isOpen: false,

          init() {
            this.load();
            window.addEventListener('storage', (e) => {
              if (e.key === 'geo-graficas-cart') this.load();
            });
          },

          load() {
            try {
              const stored = localStorage.getItem('geo-graficas-cart');
              this.items = stored ? JSON.parse(stored) : [];
            } catch {
              this.items = [];
            }
          },

          save() {
            localStorage.setItem('geo-graficas-cart', JSON.stringify(this.items));
            window.dispatchEvent(new CustomEvent('cart-updated', { 
              detail: { count: this.count, total: this.total } 
            }));
          },

          add(product) {
            const existing = this.items.find(i => i.slug === product.slug);
            if (existing) {
              existing.qty += product.qty || 1;
            } else {
              this.items.push({
                slug: product.slug,
                title: product.title,
                price: product.price,
                qty: product.qty || 1,
              });
            }
            this.save();
            this.isOpen = true;
          },

          remove(slug) {
            this.items = this.items.filter(i => i.slug !== slug);
            this.save();
          },

          updateQty(slug, qty) {
            const item = this.items.find(i => i.slug === slug);
            if (item) {
              item.qty = Math.max(1, parseInt(qty) || 1);
              this.save();
            }
          },

          clear() {
            this.items = [];
            this.save();
          },

          get count() {
            return this.items.reduce((sum, i) => sum + i.qty, 0);
          },

          get total() {
            return this.items.reduce((sum, i) => sum + i.price * i.qty, 0);
          },

          get formattedTotal() {
            return new Intl.NumberFormat('es-AR', {
              style: 'currency',
              currency: 'ARS',
              minimumFractionDigits: 0,
            }).format(this.total);
          },

          async checkout() {
            if (this.items.length === 0) return;
            
            try {
              const response = await fetch('https://geo-graficas-pay.pablo-berthold.workers.dev/checkout', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                  items: this.items.map(i => ({ slug: i.slug, quantity: i.qty })),
                  customerEmail: '',  // MP asks for email in their checkout
                }),
              });
              
              const data = await response.json();
              
              if (data.init_point) {
                this.clear();
                window.location.href = data.init_point;
              } else {
                console.error('Checkout error:', data);
                alert('Error al crear preferencia de pago');
              }
            } catch (error) {
              console.error('Checkout failed:', error);
              alert('Error de conexión');
            }
          },
        });
      });
    </script>
    
    <!-- Alpine.js for cart -->
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
  </head>
  <body x-data>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <slot />
  </body>
</html>