---
// src/components/ui/Hero.astro
import { SITE } from "../../data/site";
import { contactoUrl } from "../../data/contacto";
import { section } from "../../utils/links";

interface Props {
  alignment?: "left" | "center";
}

const { alignment = "center" } = Astro.props;
---

<section class="hero">
  <div class="container hero__inner">
    <div class="hero__badge">Profes de secundaria · Buenos Aires, Argentina</div>
    <h1 class="hero__title">
      Material áulico <span class="text-gradient">simple, actualizado y completo</span>
    </h1>
    <p class="hero__subtitle">
      {SITE.bio} Cuadernillos de actividades y recursos didácticos listos para usar en el aula.
    </p>
    <div class="hero__actions">
      <a class="hero__cta hero__cta--primary" href={section("/", "#catalogo")}>Ver catálogo</a>
      <a class="hero__cta hero__cta--secondary" href={contactoUrl()} target="_blank" rel="noopener noreferrer">
        Contactanos
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: var(--spacing-3xl) 0;
    background:
      radial-gradient(1200px 500px at 80% -10%, var(--gradient-brand-soft), transparent 60%),
      radial-gradient(800px 400px at 10% 120%, #fef3c7, transparent 55%),
      var(--color-surface-base);
  }
  .hero__inner {
    text-align: center;
    max-width: 820px;
  }
  .hero__badge {
    display: inline-block;
    padding: 0.4rem 1rem;
    border-radius: var(--radius-full);
    background: var(--color-surface-base);
    border: 1px solid var(--color-border-default);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-secondary);
    margin-bottom: var(--spacing-lg);
  }
  .hero__title {
    font-size: var(--font-size-heading-lg);
    font-weight: var(--font-weight-bold);
    letter-spacing: -0.02em;
  }
  .hero__subtitle {
    font-size: var(--font-size-lg);
    color: var(--color-text-secondary);
    margin: var(--spacing-md) auto var(--spacing-xl);
    max-width: 620px;
  }
  .hero__actions {
    display: flex;
    gap: var(--spacing-md);
    justify-content: center;
    flex-wrap: wrap;
  }
  .hero__cta {
    display: inline-flex;
    align-items: center;
    padding: 0.85rem 1.8rem;
    border-radius: var(--radius-full);
    font-weight: var(--font-weight-semibold);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .hero__cta--primary {
    color: var(--color-text-inverse);
    background: var(--gradient-brand);
    box-shadow: var(--shadow-md);
  }
  .hero__cta--secondary {
    color: var(--color-text-primary);
    border: 2px solid var(--color-border-default);
    background: var(--color-surface-base);
  }
  .hero__cta:hover {
    transform: translateY(-2px);
  }
  .hero__cta--primary:hover {
    box-shadow: var(--shadow-lg);
  }
</style>