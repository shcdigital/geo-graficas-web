---
// src/components/ui/WhatsAppFloat.astro
// Botón flotante de WhatsApp (o Instagram si no hay número configurado).
import { whatsappUrl, instagramDmUrl, whatsappHabilitado } from "../../data/contacto";
import Icon from "./Icon.astro";

const waOk = whatsappHabilitado();
const href = waOk ? (whatsappUrl() as string) : instagramDmUrl();
const iconName = waOk ? "whatsapp" : "instagram";
const isWa = waOk;
---

<a
  class="wa-float" class:list={waOk ? "wa-float" : "wa-float wa-float--ig"}
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={waOk ? "Chatear por WhatsApp" : "Enviar mensaje por Instagram"}
>
  <Icon name={iconName} size={28} />
</a>

<style>
  .wa-float {
    position: fixed;
    right: 20px;
    bottom: 20px;
    z-index: 200;
    display: grid;
    place-items: center;
    width: 60px;
    height: 60px;
    border-radius: 50%;
    color: #fff;
    background: var(--color-whatsapp);
    box-shadow: var(--shadow-lg);
    transition: transform 0.15s ease;
  }
  .wa-float--ig {
    background: var(--color-instagram);
  }
  .wa-float:hover {
    transform: scale(1.08);
    opacity: 0.9;
  }
</style>