<!-- src/components/ui/CartStore.astro -->
<!-- Global Alpine.js store for shopping cart -->
<script>
  // Cart store definition - available globally as Alpine.store('cart')
  document.addEventListener('alpine:init', () => {
    Alpine.store('cart', {
      items: [],
      isOpen: false,

      init() {
        this.load();
        // Sync across tabs
        window.addEventListener('storage', (e) => {
          if (e.key === 'geo-graficas-cart') this.load();
        });
      },

      load() {
        try {
          const stored = localStorage.getItem('geo-graficas-cart');
          this.items = stored ? JSON.parse(stored) : [];
        } catch {
          this.items = [];
        }
      },

      save() {
        localStorage.setItem('geo-graficas-cart', JSON.stringify(this.items));
        this.$dispatch('cart-updated', { count: this.count, total: this.total });
      },

      add(product) {
        const existing = this.items.find(i => i.slug === product.slug);
        if (existing) {
          existing.qty += product.qty || 1;
        } else {
          this.items.push({
            slug: product.slug,
            title: product.title,
            price: product.price,
            qty: product.qty || 1,
          });
        }
        this.save();
        this.isOpen = true;
      },

      remove(slug) {
        this.items = this.items.filter(i => i.slug !== slug);
        this.save();
      },

      updateQty(slug, qty) {
        const item = this.items.find(i => i.slug === slug);
        if (item) {
          item.qty = Math.max(1, parseInt(qty) || 1);
          this.save();
        }
      },

      clear() {
        this.items = [];
        this.save();
      },

      get count() {
        return this.items.reduce((sum, i) => sum + i.qty, 0);
      },

      get total() {
        return this.items.reduce((sum, i) => sum + i.price * i.qty, 0);
      },

      get formattedTotal() {
        return new Intl.NumberFormat('es-AR', {
          style: 'currency',
          currency: 'ARS',
          minimumFractionDigits: 0,
        }).format(this.total);
      },

      async checkout(customerEmail) {
        if (this.items.length === 0) return;
        
        try {
          const response = await fetch('https://geo-graficas-pay.pablo-berthold.workers.dev/checkout', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              items: this.items.map(i => ({ slug: i.slug, quantity: i.qty })),
              customerEmail: customerEmail || '',
            }),
          });
          
          const data = await response.json();
          
          if (data.init_point) {
            this.clear();
            window.location.href = data.init_point;
          } else {
            console.error('Checkout error:', data);
            alert('Error al crear preferencia de pago');
          }
        } catch (error) {
          console.error('Checkout failed:', error);
          alert('Error de conexión');
        }
      },
    });
  });
</script>