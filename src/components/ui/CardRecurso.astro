---
// src/components/ui/CardRecurso.astro
// Tarjeta tipo "post" de Instagram con la portada del cuadernillo.
import type { CollectionEntry } from "astro:content";
import Icon from "./Icon.astro";
import { instagramDmUrl, whatsappUrl } from "../../data/contacto";
import { route } from "../../utils/links";
import { getPrice } from "../../utils/prices";

interface Props {
  recurso: CollectionEntry<"recursos">;
}

const { recurso } = Astro.props;
const r = recurso.data;
const href = route(`/recursos/${recurso.slug}/`);
const precioFormateado = getPrice(r.precio);

// Extraer valor numérico del precio (ej: "$ 4.500" -> 4500)
const precioNumerico = parseInt(precioFormateado.replace(/[^0-9]/g, ''), 10);
const comprable = !Number.isNaN(precioNumerico);
---

<article class="card">
  {r.imagen ? (
    <a href={href} class="card__media card__media--img">
      <img class="card__img" src={r.imagen} alt={r.title} loading="lazy" />
      {r.destacado && <span class="card__badge">Destacado</span>}
    </a>
  ) : (
    <a href={href} class="card__media" style={`background: linear-gradient(135deg, ${r.coverFrom}, ${r.coverTo});`}>
      <span class="card__emoji" aria-hidden="true">{r.emoji}</span>
      <span class="card__materia">{r.materia}</span>
      {r.destacado && <span class="card__badge">Destacado</span>}
    </a>
  )}

  <div class="card__body">
    <h3 class="card__title">
      <a href={href}><span class="card__title-emoji" aria-hidden="true">{r.emoji}</span>{r.title}</a>
    </h3>
    <p class="card__meta">
      <span>{r.asignatura}</span> · <span>{r.ciclo}</span>
    </p>
    <p class="card__desc">{r.description}</p>
  </div>

  <footer class="card__footer">
    <span class="card__price">{precioFormateado}</span>
    <div class="card__actions">
      {comprable && (
        <button class="card__btn card__btn--cart" @click={`$store.cart.add({slug: "${r.precio}", title: "${r.title.replace(/"/g, '\\"')}", price: ${precioNumerico}, qty: 1})`}>
          <Icon name="cart" size={15} />
          <span>Agregar</span>
        </button>
      )}
      <a class="card__btn" href={whatsappUrl(r.title) ?? instagramDmUrl()} target="_blank" rel="noopener noreferrer" class:list={whatsappUrl(r.title) ? "card__btn--wa" : "card__btn--ig"}>
        <Icon name={whatsappUrl(r.title) ? "whatsapp" : "instagram"} size={15} />
        <span>{whatsappUrl(r.title) ? "Pedir" : "DM"}</span>
      </a>
      <a class="card__btn card__btn--ig" href={instagramDmUrl()} target="_blank" rel="noopener noreferrer" aria-label="Mensaje por Instagram">
        <Icon name="instagram" size={15} />
        <span>DM</span>
      </a>
    </div>
  </footer>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border-default);
    background: var(--color-surface-base);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
    transition: box-shadow 0.18s ease, transform 0.18s ease;
  }
  .card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
  }
  .card__media {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 3;
  }
  .card__media--img {
    overflow: hidden;
    background: var(--color-surface-soft);
  }
  .card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .card__emoji {
    font-size: 3.25rem;
    filter: drop-shadow(0 4px 8px rgba(0, 0, 0, 0.18));
  }
  .card__materia {
    position: absolute;
    left: var(--spacing-sm);
    bottom: var(--spacing-sm);
    color: #fff;
    font-weight: var(--font-weight-semibold);
    font-size: var(--font-size-sm);
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.4);
  }
  .card__title {
    font-size: var(--font-size-lg);
    margin-bottom: var(--spacing-xs);
  }
  .card__title a:hover {
    color: var(--color-brand-primary);
  }
  .card__title-emoji {
    margin-right: 0.35rem;
    font-size: 1.1em;
  }
  .card__badge {
    position: absolute;
    top: var(--spacing-sm);
    right: var(--spacing-sm);
    padding: 0.25rem 0.65rem;
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-bold);
    color: #fff;
    border-radius: var(--radius-full);
    background: var(--gradient-brand);
  }
  .card__body {
    padding: var(--spacing-md);
    flex: 1;
  }
  .card__meta {
    color: var(--color-text-secondary);
    font-size: var(--font-size-sm);
    margin-bottom: var(--spacing-sm);
  }
  .card__desc {
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .card__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--spacing-sm) var(--spacing-md) var(--spacing-md);
  }
  .card__price {
    font-weight: var(--font-weight-bold);
    color: var(--color-brand-primary);
  }
  .card__actions {
    display: flex;
    gap: var(--spacing-xs);
    align-items: center;
  }
  .card__dm {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 1px solid var(--color-border-default);
    color: var(--color-brand-end);
    font-size: var(--font-size-xs);
  }
  .card__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.5rem 0.9rem;
    border-radius: var(--radius-full);
    font-weight: var(--font-weight-semibold);
    font-size: var(--font-size-sm);
    color: #fff;
  }
  .card__btn--wa {
    background: var(--color-whatsapp);
  }
  .card__btn--ig {
    background: var(--color-instagram);
  }
  .card__btn--wa:hover,
  .card__btn--ig:hover {
    opacity: 0.9;
    transform: translateY(-1px);
  }
</style>