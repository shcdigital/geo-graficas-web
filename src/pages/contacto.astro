---
// src/pages/contacto.astro
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/ui/Navbar.astro";
import Footer from "../components/ui/Footer.astro";
import WhatsAppFloat from "../components/ui/WhatsAppFloat.astro";
import Icon from "../components/ui/Icon.astro";

import { SITE } from "../data/site";
import { whatsappUrl, instagramDmUrl, instagramPerfilUrl, whatsappHabilitado } from "../data/contacto";

const wa = whatsappUrl();
const waOk = whatsappHabilitado();
---

<Layout title="Contacto" description={`Contactanos: ${SITE.bio}`}>
  <Navbar />
  <main id="contenido">
    <section class="wrapper">
      <div class="container contacto">
        <h1 class="contacto__titulo">Hablemos <span class="text-gradient">👋</span></h1>
        <p class="contacto__intro">
          Escribinos y te respondemos a la brevedad. Trabajamos por WhatsApp e Instagram para que el encargo sea simple.
        </p>

        <div class="contacto__grid">
          <a
            class="tarjeta"
            href={waOk ? (whatsappUrl() as string) : instagramDmUrl()}
            target="_blank"
            rel="noopener noreferrer"
            class:list={waOk ? "tarjeta--wa" : "tarjeta--ig"}
          >
            <span class="tarjeta__icono" class:list={waOk ? "tarjeta__icono--wa" : "tarjeta__icono--ig"}><Icon name={waOk ? "whatsapp" : "instagram"} size={26} /></span>
            <span class="tarjeta__titulo">{waOk ? "WhatsApp" : "Instagram DM"}</span>
            <span class="tarjeta__detalle">{waOk ? "Chat directo y rápido" : "Respondemos por mensaje directo"}</span>
          </a>

          <a class="tarjeta tarjeta--ig" href={instagramPerfilUrl()} target="_blank" rel="noopener noreferrer">
            <span class="tarjeta__icono tarjeta__icono--ig"><Icon name="instagram" size={26} /></span>
            <span class="tarjeta__titulo">@{SITE.instagram}</span>
            <span class="tarjeta__detalle">Mirá el feed completo de recursos</span>
          </a>

          <a class="tarjeta" href={`mailto:${SITE.email}`}>
            <span class="tarjeta__icono tarjeta__icono--mail">✉️</span>
            <span class="tarjeta__titulo">Correo</span>
            <span class="tarjeta__detalle">{SITE.email}</span>
          </a>
        </div>

        <p class="contacto__nota">
          ¿Buscás un material específico? Mandanos la materia, curso y tema:
          lo armamos para tu aula.
        </p>
      </div>
    </section>
  </main>

  <WhatsAppFloat />
  <Footer />
</Layout>

<style>
  .wrapper {
    padding: var(--spacing-3xl) var(--container-pad);
  }
  .contacto__titulo {
    font-size: var(--font-size-heading-lg);
    text-align: center;
    margin-bottom: var(--spacing-md);
  }
  .contacto__intro {
    text-align: center;
    color: var(--color-text-secondary);
    max-width: 560px;
    margin-inline: auto;
    font-size: var(--font-size-lg);
  }
  .contacto__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--spacing-lg);
    margin-top: var(--spacing-2xl);
  }
  .tarjeta {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--spacing-sm);
    padding: var(--spacing-xl);
    border-radius: var(--radius-md);
    transition: box-shadow 0.18s ease, transform 0.18s ease;
    color: var(--color-text-inverse);
  }
  .tarjeta--wa {
    background: var(--color-whatsapp);
    border: 1px solid var(--color-whatsapp-dark);
  }
  .tarjeta--ig {
    background: var(--color-instagram);
    border: 1px solid var(--color-instagram-dark);
  }
  .tarjeta:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
    opacity: 0.9;
  }
  .tarjeta__icono {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--gradient-brand-soft);
    color: var(--color-brand-end);
  }
  .tarjeta__icono--wa {
    background: var(--color-whatsapp);
    color: var(--color-text-inverse);
  }
  .tarjeta__icono--ig {
    background: var(--color-instagram);
    color: var(--color-text-inverse);
  }
  .tarjeta__titulo {
    font-weight: var(--font-weight-bold);
    font-size: var(--font-size-lg);
  }
  .tarjeta__detalle {
    color: var(--color-text-secondary);
    font-size: var(--font-size-sm);
  }
  .contacto__nota {
    margin-top: var(--spacing-2xl);
    text-align: center;
    color: var(--color-text-secondary);
    max-width: 520px;
    margin-inline: auto;
  }
</style>