---
// src/pages/recursos/[slug].astro
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/ui/Navbar.astro";
import Footer from "../../components/ui/Footer.astro";
import WhatsAppFloat from "../../components/ui/WhatsAppFloat.astro";
import Icon from "../../components/ui/Icon.astro";

import { getCollection } from "astro:content";
import { whatsappUrl, instagramDmUrl } from "../../data/contacto";
import { section } from "../../utils/links";
import { getPrice } from "../../utils/prices";

export async function getStaticPaths() {
  const recursos = await getCollection("recursos");
  return recursos
    .filter((r) => !r.data.draft)
    .map((r) => ({ params: { slug: r.slug }, props: { recurso: r } }));
}

const { recurso } = Astro.props;
const r = recurso.data;
const { Content } = await recurso.render();
const wa = whatsappUrl(r.title);
const precioFormateado = getPrice(r.precio);
---

<Layout
  title={`${r.title} · ${r.materia}`}
  description={r.description}
  ogType="article"
>
  <Navbar />
  <main id="contenido">
    <article class="container detalle">
      <a class="detalle__back" href={section("/", "#catalogo")}>← Volver al catálogo</a>

      <div class="detalle__grid">
        {r.imagen ? (
          <div class="detalle__cover detalle__cover--img">
            <img class="detalle__img" src={r.imagen} alt={r.title} />
            {r.destacado && <span class="detalle__badge">Destacado</span>}
          </div>
        ) : (
          <div
            class="detalle__cover"
            style={`background: linear-gradient(135deg, ${r.coverFrom}, ${r.coverTo});`}
          >
            <span class="detalle__emoji" aria-hidden="true">{r.emoji}</span>
            <span class="detalle__materia">{r.materia}</span>
            {r.destacado && <span class="detalle__badge">Destacado</span>}
          </div>
        )}

        <div class="detalle__info">
          <p class="detalle__meta">{r.asignatura} · {r.ciclo}</p>
          <h1 class="detalle__titulo"><span class="detalle__titulo-emoji" aria-hidden="true">{r.emoji}</span>{r.title}</h1>
          <p class="detalle__desc">{r.description}</p>

          <dl class="detalle__datos">
            <div>
              <dt>Formato</dt>
              <dd>{r.formato}</dd>
            </div>
            <div>
              <dt>Páginas</dt>
              <dd>{r.paginas}</dd>
            </div>
            <div>
              <dt>Nivel</dt>
              <dd>{r.nivel}</dd>
            </div>
          </dl>

          <p class="detalle__precio">{precioFormateado}</p>

          <div class="detalle__botones">
            <a class="detalle__btn" href={wa ?? instagramDmUrl()} target="_blank" rel="noopener noreferrer" class:list={wa ? "detalle__btn--wa" : "detalle__btn--ig"}>
              <Icon name={wa ? "whatsapp" : "instagram"} size={20} />
              <span>{wa ? "Pedir por WhatsApp" : "Mensaje por Instagram"}</span>
            </a>
            <a class="detalle__btn detalle__btn--ig" href={instagramDmUrl()} target="_blank" rel="noopener noreferrer">
              <Icon name="instagram" size={20} />
              <span>Consultar por IG</span>
            </a>
          </div>
        </div>
      </div>

      <section class="detalle__cuerpo" aria-label="Contenido del cuadernillo">
        <div class="prose">
          <Content />
        </div>

        <div class="detalle__bloques">
          <div class="bloque">
            <h2>Unidades</h2>
            <ul>
              {r.unidades.map((u) => (
                <li>{u}</li>
              ))}
            </ul>
          </div>
          <div class="bloque">
            <h2>El material incluye</h2>
            <ul>
              {r.incluye.map((i) => (
                <li>{i}</li>
              ))}
            </ul>
          </div>
        </div>
      </section>
    </article>
  </main>

  <WhatsAppFloat />
  <Footer />
</Layout>

<style>
  .detalle {
    padding: var(--spacing-2xl) var(--container-pad);
  }
  .detalle__back {
    display: inline-block;
    margin-bottom: var(--spacing-lg);
    color: var(--color-text-secondary);
    font-weight: var(--font-weight-medium);
  }
  .detalle__back:hover {
    color: var(--color-brand-primary);
  }
  .detalle__grid {
    display: grid;
    grid-template-columns: minmax(280px, 0.9fr) 1.1fr;
    gap: var(--spacing-3xl);
    align-items: start;
  }
  .detalle__cover {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    overflow: hidden;
  }
  .detalle__cover--img {
    background: var(--color-surface-soft);
  }
  .detalle__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .detalle__emoji {
    font-size: 6rem;
    filter: drop-shadow(0 6px 12px rgba(0, 0, 0, 0.2));
  }
  .detalle__materia {
    position: absolute;
    left: var(--spacing-lg);
    bottom: var(--spacing-lg);
    color: #fff;
    font-weight: var(--font-weight-bold);
    font-size: var(--font-size-xl);
    text-shadow: 0 2px 6px rgba(0, 0, 0, 0.35);
  }
  .detalle__badge {
    position: absolute;
    top: var(--spacing-md);
    right: var(--spacing-md);
    padding: 0.3rem 0.9rem;
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-bold);
    color: #fff;
    border-radius: var(--radius-full);
    background: rgba(0, 0, 0, 0.45);
  }
  .detalle__meta {
    color: var(--color-text-secondary);
    font-weight: var(--font-weight-medium);
    margin-bottom: var(--spacing-sm);
  }
  .detalle__titulo {
    font-size: var(--font-size-heading-md);
    margin-bottom: var(--spacing-md);
  }
  .detalle__titulo-emoji {
    margin-right: 0.5rem;
  }
  .detalle__desc {
    color: var(--color-text-secondary);
    font-size: var(--font-size-lg);
  }
  .detalle__datos {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--spacing-md);
    margin: var(--spacing-lg) 0;
  }
  .detalle__datos div {
    background: var(--color-surface-soft);
    border-radius: var(--radius-md);
    padding: var(--spacing-md);
  }
  .detalle__datos dt {
    font-size: var(--font-size-xs);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-text-secondary);
  }
  .detalle__datos dd {
    margin: var(--spacing-xs) 0 0;
    font-weight: var(--font-weight-bold);
  }
  .detalle__precio {
    font-size: var(--font-size-heading-sm);
    font-weight: var(--font-weight-bold);
    color: var(--color-brand-primary);
    margin-bottom: var(--spacing-lg);
  }
  .detalle__botones {
    display: flex;
    gap: var(--spacing-md);
    flex-wrap: wrap;
  }
  .detalle__btn {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-sm);
    padding: 0.85rem 1.5rem;
    border-radius: var(--radius-full);
    font-weight: var(--font-weight-semibold);
    color: #fff;
    transition: transform 0.15s ease, opacity 0.15s ease;
  }
  .detalle__btn--wa {
    background: var(--color-whatsapp);
  }
  .detalle__btn--ig {
    background: var(--color-instagram);
  }
  .detalle__btn:hover {
    transform: translateY(-2px);
    opacity: 0.9;
  }
  .detalle__cuerpo {
    margin-top: var(--spacing-3xl);
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: var(--spacing-3xl);
  }
  .prose p {
    color: var(--color-text-secondary);
  }
  .detalle__bloques {
    display: grid;
    gap: var(--spacing-lg);
  }
  .bloque {
    background: var(--color-surface-soft);
    border-radius: var(--radius-md);
    padding: var(--spacing-lg);
  }
  .bloque h2 {
    font-size: var(--font-size-lg);
    margin-bottom: var(--spacing-sm);
  }
  .bloque ul {
    margin: 0;
    padding-left: var(--spacing-lg);
    color: var(--color-text-secondary);
    display: grid;
    gap: var(--spacing-xs);
  }
  @media (max-width: 820px) {
    .detalle__grid,
    .detalle__cuerpo {
      grid-template-columns: 1fr;
    }
  }
</style>