---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/ui/Navbar.astro";
import Footer from "../../components/ui/Footer.astro";
---

<Layout title="Pago rechazado · Geo Gráficas">
  <Navbar />
  <main id="contenido" class="container">
    <section class="checkout-result checkout-result--failure">
      <div class="checkout-result__icon" aria-hidden="true">❌</div>
      <h1>Pago rechazado</h1>
      <p class="checkout-result__message">
        No se pudo procesar el pago. Podés volver a intentarlo o contactarnos por WhatsApp.
      </p>
      <div class="checkout-result__actions">
        <a href="/#catalogo" class="btn btn--primary">Volver al carrito</a>
        <a href="https://wa.me/541167040934?text=Hola%20Geo.Gr%C3%A1ficas%20%F0%9F%91%8B%20Tuve%20un%20problema%20con%20el%20pago." target="_blank" rel="noopener noreferrer" class="btn btn--secondary">
          Ayuda por WhatsApp
        </a>
      </div>
    </section>
  </main>
  <Footer />

  <style>
    .checkout-result {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      padding: var(--spacing-3xl) var(--spacing-lg);
      max-width: 480px;
      margin: 0 auto;
    }
    .checkout-result__icon {
      font-size: 4rem;
      margin-bottom: var(--spacing-lg);
    }
    .checkout-result h1 {
      margin-bottom: var(--spacing-md);
      color: var(--color-text-primary);
    }
    .checkout-result__message {
      color: var(--color-text-secondary);
      margin-bottom: var(--spacing-xl);
      line-height: 1.6;
    }
    .checkout-result__actions {
      display: flex;
      gap: var(--spacing-md);
      flex-wrap: wrap;
      justify-content: center;
    }
    .btn {
      display: inline-flex;
      align-items: center;
      padding: 0.85rem 1.5rem;
      border-radius: var(--radius-full);
      font-weight: var(--font-weight-semibold);
      text-decoration: none;
      transition: transform 0.15s ease, opacity 0.15s ease;
    }
    .btn:hover {
      transform: translateY(-2px);
    }
    .btn--primary {
      background: var(--gradient-brand);
      color: #fff;
    }
    .btn--secondary {
      background: var(--color-surface-soft);
      color: var(--color-text-primary);
      border: 1px solid var(--color-border-default);
    }
    .checkout-result--success .checkout-result__icon { color: var(--color-success); }
    .checkout-result--failure .checkout-result__icon { color: var(--color-error); }
    .checkout-result--pending .checkout-result__icon { color: var(--color-warning); }
  </style>